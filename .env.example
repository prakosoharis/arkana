POSTGRES_DB=arkana
POSTGRES_USER=arkana
POSTGRES_PASSWORD=arkana_local_only
RESEARCH_DATABASE_URL=postgresql+psycopg://arkana:arkana_local_only@postgres:5432/arkana
RESEARCH_DATA_ROOT=/workspace/data/processed
# ARK-S23-01: the research API refuses every request without this token, and
# the BFF injects it server-side only. Generate one per machine, never commit it:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
RESEARCH_API_TOKEN=
NEXT_PUBLIC_RESEARCH_API_URL=http://localhost:8001
RESEARCH_API_URL=http://research:8000
# Set this to the MT5 Terminal Common\Files directory on macOS for Sprint 07 local deployment.
MT5_COMMON_FILES_ROOT=./data/mt5-common
# AI Research Assistant: disabled unless the owner explicitly enables it.
# Primary provider-agnostic contract.  It supports OpenAI-compatible APIs and
# Anthropic Messages APIs; credentials must remain server-side only.
AI_ENABLED=false
AI_PROVIDER=tencent
AI_API_KEY=
AI_BASE_URL=https://tokenhub-intl.tencentcloudmaas.com/v1
AI_PROTOCOL=openai_compatible
AI_ENDPOINT_PATH=/chat/completions
AI_AUTH_HEADER=Authorization
AI_AUTH_PREFIX="Bearer "
AI_EXTRA_HEADERS_JSON={}
AI_JSON_MODE=false
AI_THINKING_ENABLED=false
AI_MODEL_FAST=glm-5.1
AI_MODEL_REASONING=glm-5.1
# Presets: tencent, zai, openai, anthropic. Any provider with one of the two
# protocols above can also be configured explicitly with these generic fields.
# Legacy Z.AI/Meta variables below are migration-only compatibility fields.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=
META_MODEL_ID=
AI_MONTHLY_BUDGET_USD=0
AI_REQUEST_LIMIT=100
AI_REQUEST_MAX_INPUT_TOKENS=4000
AI_REQUEST_MAX_OUTPUT_TOKENS=1600
AI_REQUEST_MAX_COST_USD=0.05
HISTORICAL_SYNC_INTERVAL_SECONDS=3600
HISTORICAL_SYNC_POLL_SECONDS=30
HISTORICAL_SYNC_RESPONSE_TIMEOUT_SECONDS=300
